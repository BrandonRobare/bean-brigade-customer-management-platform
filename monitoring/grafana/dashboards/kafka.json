{
  "uid": "crm-kafka",
  "title": "CRM Kafka",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "kafka",
    "crm"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Consumer lag",
      "description": "Maximum fetch-manager lag per API instance/client. Missing or stale during broker outage is not proof of no backlog.",
      "datasource": {
        "type": "prometheus",
        "uid": "crm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance, client_id) (kafka_consumer_fetch_manager_records_lag_max{job=\"crm-api\"})",
          "legendFormat": "{{instance}} {{client_id}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Processed in range",
      "description": "Events the consumer finished, including duplicates skipped by eventId. Counter resets are handled by increase.",
      "datasource": {
        "type": "prometheus",
        "uid": "crm-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (increase(crm_kafka_messages_total{job=\"crm-api\",outcome=\"processed\"}[$__range]))",
          "legendFormat": "{{topic}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Dead letters in range",
      "description": "Successful dead-letter publications, not the current DLT topic depth. Counter resets are handled by increase.",
      "datasource": {
        "type": "prometheus",
        "uid": "crm-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (increase(crm_kafka_messages_total{job=\"crm-api\",outcome=\"dead_lettered\"}[$__range]))",
          "legendFormat": "{{topic}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Kafka failures per second",
      "description": "Rate of failed outcomes over five minutes. Interpret retries and dead letters with the DLT runbook.",
      "datasource": {
        "type": "prometheus",
        "uid": "crm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(crm_kafka_messages_total{job=\"crm-api\",outcome=\"failed\"}[5m]))",
          "legendFormat": "{{topic}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP 5xx per second",
      "description": "Rate of HTTP server 5xx responses over five minutes. A successful HTTP response does not prove Kafka delivery.",
      "datasource": {
        "type": "prometheus",
        "uid": "crm-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"crm-api\",status=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "HTTP 5xx",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
